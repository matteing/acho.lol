{
  "name": "acho-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --import tsx scripts/prepare-media.ts && node --import tsx scripts/prepare-social.ts && astro dev --host 127.0.0.1",
    "build": "node --import tsx scripts/prepare-media.ts && node --import tsx scripts/prepare-social.ts && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "verify": "python3 scripts/verify-build.py",
    "audit:content": "node --import tsx scripts/audit-content.ts",
    "verify:seo": "python3 scripts/verify-seo.py",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prepare": "node scripts/prepare-hooks.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm audit:content && pnpm build && pnpm verify && pnpm verify:seo"
  },
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "dependencies": {
    "astro": "7.3.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.12.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/unist": "3.0.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "mdast-util-from-markdown": "2.0.3",
    "micromark-util-types": "2.0.2",
    "pagefind": "^1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "schema-dts": "2.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "description": "A bilingual encyclopedia of Puerto Rican popular culture, built with Astro.",
  "license": "MIT"
}
