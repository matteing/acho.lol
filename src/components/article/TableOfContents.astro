---
import './article-sidebar.css';
import type { WikiPage } from '@/lib/wiki/types';
import { t } from '@/i18n/translate';
interface Props {
  page: WikiPage;
}
const { page } = Astro.props;
const headings = page.headings.filter((heading) => heading.depth <= 3);
---

{headings.length > 0 && (
  <nav class="table-of-contents" aria-label={t(page.lang, 'toc')}>
    <h2 class="article-rail-heading">{t(page.lang, 'toc')}</h2>
    <ol>
      {headings.map((heading) => (
        <li class:list={{ 'toc-nested': heading.depth > 2 }}>
          <a class="toc-link" href={`#${heading.slug}`}>
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
